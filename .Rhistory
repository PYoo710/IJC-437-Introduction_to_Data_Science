setwd("~/Documents/IJC-437-Introduction_to_Data_Science")
library(dplyr)
library(lubridate)
library(ggplot2)
library(pROC)
library(caret)
# Path to folder containing all PM2.5 CSV files
data_path <- "Dataset/pm"
# Read all CSV files and combine into a single data frame
files <- list.files(data_path, pattern = "\\.csv$", full.names = TRUE)
air_all <- files %>%
lapply(read_csv) %>%
bind_rows()
# Clean and parse datetime
air_all <- air_all %>%
mutate(
# remove trailing "Z" from datetime string if present
datetime_clean = gsub("Z", "", datetimeUtc),
datetime       = ymd_hms(datetime_clean, quiet = TRUE)
) %>%
# keep only rows with valid datetime
filter(!is.na(datetime))
wind_raw <- read.csv("Dataset/WIND/wind.csv")
# Remove header rows and keep first three columns (time, speed, direction)
wind_clean <- wind_raw[-c(1, 2), 1:3]
names(wind_clean) <- c("time", "wind_speed_10m", "wind_direction_10m")
wind_clean <- wind_clean %>%
mutate(
time               = as.POSIXct(time, format = "%Y-%m-%dT%H:%M", tz = "GMT"),
wind_speed_10m     = as.numeric(wind_speed_10m),
wind_direction_10m = as.numeric(wind_direction_10m)
)
# Convert to openair-friendly format:
#   date = datetime, ws = wind speed (m/s), wd = wind direction (degrees)
wind_df <- wind_clean %>%
transmute(
date = time,
wind_speed  = wind_speed_10m / 3.6,   # convert from km/h to m/s
wind_direction   = wind_direction_10m
)
pm_hourly <- air_all %>%
transmute(
date = as.POSIXct(datetime_clean),
pm25 = value
)
pm_wind_hourly <- pm_hourly %>%
inner_join(wind_df, by = "date")
df <- pm_wind_hourly %>%
filter(!is.na(pm25), !is.na(wind_speed), !is.na(wind_direction)) %>%
mutate(
# 1) Choose a threshold for "high PM2.5"
# Option A: WHO 24h guideline (15 µg/m3) is daily-based, but we can use it as a simple event threshold.
# Option B: use a higher threshold like 25 to capture "episodes".
high_pm25 = ifelse(pm25 >= 25, 1, 0),
# 2) Feature engineering for circular wind direction
wd_rad = wind_direction * pi / 180,
wd_sin = sin(wd_rad),
wd_cos = cos(wd_rad),
# 3) Time features (optional but often helpful)
hour  = hour(date),
month = month(date),
wday  = wday(date, week_start = 1)  # 1=Mon..7=Sun
) %>%
select(date, pm25, high_pm25, wind_speed, wd_sin, wd_cos, hour, month, wday)
View(df)
table(df$high_pm25)
prop.table(table(df$high_pm25))
df <- df %>% arrange(date)
split_point <- floor(0.8 * nrow(df))
train <- df[1:split_point, ]
test  <- df[(split_point + 1):nrow(df), ]
model_logit <- glm(
high_pm25 ~ wind_speed + wd_sin + wd_cos + hour + month + wday,
data = train,
family = binomial()
)
model_logitic <- glm(
high_pm25 ~ wind_speed + wd_sin + wd_cos + hour + month + wday,
data = train,
family = binomial()
)
summary(model_logitic)
test$prob_high <- predict(model_logit, newdata = test, type = "response")
cutoff <- 0.5
test$pred_high <- ifelse(test$prob_high >= cutoff, 1, 0)
cm <- caret::confusionMatrix(
factor(test$pred_high, levels = c(0,1)),
factor(test$high_pm25, levels = c(0,1))
)
cm
roc_obj <- pROC::roc(test$high_pm25, test$prob_high, quiet = TRUE)
auc_val <- pROC::auc(roc_obj)
auc_val
plot(roc_obj, main = paste0("ROC Curve (AUC = ", round(auc_val, 3), ")"))
ggplot(test, aes(x = wind_speed, y = prob_high)) +
geom_point(alpha = 0.2) +
geom_smooth() +
labs(
title = "Predicted probability of high PM2.5 vs wind speed",
x = "Wind speed (m/s)",
y = "Predicted P(high PM2.5)"
) +
theme_minimal()
df <- pm_wind_hourly %>%
filter(!is.na(pm25), !is.na(wind_speed), !is.na(wind_direction)) %>%
mutate(
high_pm25 = ifelse(pm25 >= 15, 1, 0),
wd_rad = wind_direction * pi / 180,
wd_sin = sin(wd_rad),
wd_cos = cos(wd_rad),
hour  = hour(date),
month = month(date),
wday  = wday(date, week_start = 1)
) %>%
select(date, pm25, high_pm25, wind_speed, wd_sin, wd_cos, hour, month, wday)
table(df$high_pm25)
prop.table(table(df$high_pm25))
df <- df %>% arrange(date)
split_point <- floor(0.8 * nrow(df))
train <- df[1:split_point, ]
test  <- df[(split_point + 1):nrow(df), ]
model_logitic <- glm(
high_pm25 ~ wind_speed + wd_sin + wd_cos + hour + month + wday,
data = train,
family = binomial()
)
summary(model_logitic)
test$prob_high <- predict(model_logit, newdata = test, type = "response")
cutoff <- 0.5
test$pred_high <- ifelse(test$prob_high >= cutoff, 1, 0)
cm <- caret::confusionMatrix(
factor(test$pred_high, levels = c(0,1)),
factor(test$high_pm25, levels = c(0,1))
)
cm
roc_obj <- pROC::roc(test$high_pm25, test$prob_high, quiet = TRUE)
auc_val <- pROC::auc(roc_obj)
auc_val
plot(roc_obj, main = paste0("ROC Curve (AUC = ", round(auc_val, 3), ")"))
ggplot(test, aes(x = wind_speed, y = prob_high)) +
geom_point(alpha = 0.2) +
geom_smooth() +
labs(
title = "Predicted probability of high PM2.5 vs wind speed",
x = "Wind speed (m/s)",
y = "Predicted P(high PM2.5)"
) +
theme_minimal()
