"SP.DYN.LE00.IN",     # life expectancy
"SP.URB.TOTL.IN.ZS"   # urban population %
),
start = 2019, end = 2019,
extra = TRUE,
cache = new_wdi_cache
)
#Exercise5
pop <- WDI(
indicator = c(
"SP.POP.TOTL",        # total population
"SP.POP.GROW",        # population growth
"SP.DYN.TFRT.IN",     # fertility rate
"SP.DYN.LE00.IN",     # life expectancy
"SP.URB.TOTL.IN.ZS"   # urban population %
),
start = 2019, end = 2019,
extra = TRUE,
cache = new_wdi_cache
)
#Exercise5
pop <- WDI(
indicator = c(
"SP.POP.TOTL",        # total population
"SP.POP.GROW",        # population growth
"SP.DYN.TFRT.IN",     # fertility rate
"SP.DYN.LE00.IN",     # life expectancy
"SP.URB.TOTL.IN.ZS"   # urban population %
),
start = 2019, end = 2019,
extra = TRUE,
cache = new_wdi_cache
)
# เอาเฉพาะประเทศ (ไม่เอา Aggregates) และลบ NA
pop <- pop[pop$region != "Aggregates", ]
pop <- na.omit(pop)
# เก็บชื่อคอลัมน์ตัวแปรที่ใช้วิเคราะห์
indicators <- c("SP.POP.TOTL","SP.POP.GROW",
"SP.DYN.TFRT.IN","SP.DYN.LE00.IN",
"SP.URB.TOTL.IN.ZS")
# PCA (scale = TRUE เพราะสเกลแต่ละตัวต่างกันมาก)
pca_pop <- prcomp(pop[, indicators], scale = TRUE)
pop.pca <- data.frame(
country = pop$country,
region  = pop$region,
income  = pop$income,
PC1 = pca_pop$x[,1],
PC2 = pca_pop$x[,2]
)
# 3.1 แสดงเป็น text (ชื่อประเทศ)
ggplot(pop.pca, aes(PC1, PC2, label = country)) +
geom_text(size = 3) +
labs(
title = "PCA of Population Dynamics (2019)",
caption = "World Bank"
)
# 3.2 แสดงเป็นจุด + สีตาม region
ggplot(pop.pca, aes(PC1, PC2, colour = region)) +
geom_point(size = 3) +
labs(
title = "PCA of Population Dynamics (2019)",
colour = "Region",
caption = "World Bank"
)
ggparcoord(
pop,
columns = match(indicators, names(pop)),  # ใช้อินเด็กซ์จากชื่อคอลัมน์
groupColumn = "income",
scale = "std"
) +
theme(
axis.text.x = element_text(angle = 45),
panel.background = element_blank()
) +
geom_vline(xintercept = 1:length(indicators), colour = "grey80") +
labs(
colour  = "Income level",
x       = "Population indicators",
y       = "Scaled values",
title   = "Parallel Coordinates of Population Dynamics by Income Level (2019)",
caption = "World Bank"
)
ggparcoord(
pop,
columns = match(indicators, names(pop)),  # ใช้อินเด็กซ์จากชื่อคอลัมน์
groupColumn = "income",
scale = "std"
) +
theme(
axis.text.x = element_text(angle = 45),
panel.background = element_blank()
) +
geom_vline(xintercept = 1:length(indicators), colour = "grey80") +
labs(
colour  = "Income level",
x       = "Population indicators",
y       = "Scaled values",
title   = "Parallel Coordinates of Population Dynamics by Income Level (2019)",
caption = "World Bank"
)# ไม่เอา year เข้ากราฟ
pop$year <- NULL
pop %>%
mutate_if(is.numeric, rescale) %>%                        # scale 0–1
mutate(income_clean = str_replace_all(income, " ", "_")) %>%
group_by(income_clean) %>%
summarise_if(is.numeric, mean) %>%
ggradar(
axis.label.size   = 3,
legend.text.size  = 8
)
pop_time <- WDI(
indicator = indicators,
start = 2000, end = 2019,
extra = TRUE,
cache = new_wdi_cache
)
pop_time <- pop_time[pop_time$region != "Aggregates", ]
pop_time <- na.omit(pop_time)
# ตัวอย่าง: ทำ PCA เฉพาะปี 2000 กับ 2019 เทียบกัน
pop_2000 <- subset(pop_time, year == 2000)
pop_2019 <- subset(pop_time, year == 2019)
